rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isRoleOwner(roleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/openrole_roles/$(roleId))
        && get(/databases/$(database)/documents/openrole_roles/$(roleId)).data.ownerUid == request.auth.uid;
    }

    match /openrole_roles/{roleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'name', 'role']);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == ((resource.data.views is int) ? resource.data.views : 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && (request.resource.data.votes == ((resource.data.votes is int) ? resource.data.votes : 0) + 1
            || request.resource.data.votes == ((resource.data.votes is int) ? resource.data.votes : 0) - 1)
          && request.resource.data.votes >= 0
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount'])
          && request.resource.data.applicationCount == ((resource.data.applicationCount is int) ? resource.data.applicationCount : 0) + 1
        )
      );

      match /offers/{offerId} {
        allow read: if isRoleOwner(roleId);
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/openrole_roles/$(roleId))
          && request.resource.data.roleId == roleId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && !('accepted' in request.resource.data && request.resource.data.accepted == true);
        allow update: if isRoleOwner(roleId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'accepted', 'acceptedAt'])
          && request.resource.data.status in ['hired', 'declined']
          && (request.resource.data.status != 'hired' || request.resource.data.accepted == true);
        allow delete: if isRoleOwner(roleId);
      }
    }
  }
}